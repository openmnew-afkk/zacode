# ===== TeleCinema =====
# TMDB API ключ (опционально, встроенный ключ работает по умолчанию)
# Если задан — переопределяет встроенный ключ
TMDB_API_KEY=dc003aabe0e60ef32360bfdf70deac32

# Базовый URL API (для прода — пусто)
# VITE_API_BASE=http://localhost:3000

# RU-Proxy — адрес прокси-сервера на российском VPS (папка /proxy).
# Позволяет пользователям с VPN смотреть русские озвучки (Kodik и др.).
# Можно также задать в админке приложения — там приоритет выше.
# Этот же сервер раздаёт центральный конфиг (админка, премиум, оплата).
# VITE_RU_PROXY=https://ru-proxy.example.com

# Мини-бэкенд (если развернут отдельно от RU-Proxy)
# VITE_API_BASE=https://api.example.com
